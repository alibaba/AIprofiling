From b5a4a7a9f1b60381be9647265a4690fa96955d11 Mon Sep 17 00:00:00 2001
From: AlanFokCo <alanfok2868@gmail.com>
Date: Tue, 8 Sep 2026 15:51:02 +0800
Subject: [PATCH 2/3] aiprof: emit kernel timestamps in CLOCK_MONOTONIC to fuse
 with pyki

CUPTI reports activity timestamps as CLOCK_REALTIME (epoch) nanoseconds,
while pyki / torch.profiler timestamps are CLOCK_MONOTONIC. AIProf renders
both sources on one Perfetto timeline, so an unadjusted CUPTI trace lands
~56 years away from the Python-stack lanes and the fused view is unusable.

Compute (CLOCK_REALTIME - CLOCK_MONOTONIC) once in LoadConfig() and subtract
it per event in WriteChromeTrace(). A timestamp at or below the offset is
left unchanged rather than subtracted, so a pre-offset timestamp can never
wrap uint64.

This deliberately implements 'framework/Python stack fusion', which upstream
cuprof lists as a non-goal in docs/design.md; keep it local unless upstream
adopts it.
---
 src/config.cc       | 14 ++++++++++++++
 src/config.h        |  8 ++++++++
 src/cupti_sink.cc   |  4 +++-
 src/trace_writer.cc | 15 ++++++++++++---
 src/trace_writer.h  |  8 ++++++--
 5 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/src/config.cc b/src/config.cc
index 39b1e19..b6144d6 100644
--- a/src/config.cc
+++ b/src/config.cc
@@ -1,5 +1,8 @@
+// AIProf-local modification (Apache-2.0 4(b)): this file differs from
+// upstream cuprof. See VENDOR.md and patches/0002-align-cupti-epoch-to-clock-monotonic.patch.
 #include "config.h"
 
+#include <time.h>
 #include <unistd.h>
 
 #include <cstdlib>
@@ -71,6 +74,17 @@ Config LoadConfig() {
                          : 0;
     c.verbose = kv.count("CUPROF_VERBOSE") && strtol(kv["CUPROF_VERBOSE"].c_str(), NULL, 10) != 0;
     c.socket_path = kv.count("CUPROF_SOCKET") ? kv["CUPROF_SOCKET"] : "";
+
+    // CUPTI timestamps are epoch (CLOCK_REALTIME) nanoseconds. PyTorch
+    // profiler (pyki) uses CLOCK_MONOTONIC. To align them on the same
+    // timeline in Perfetto/chrome-trace viewers, subtract the difference.
+    struct timespec rt, mt;
+    clock_gettime(CLOCK_REALTIME, &rt);
+    clock_gettime(CLOCK_MONOTONIC, &mt);
+    uint64_t rt_ns = static_cast<uint64_t>(rt.tv_sec) * 1000000000ULL + rt.tv_nsec;
+    uint64_t mt_ns = static_cast<uint64_t>(mt.tv_sec) * 1000000000ULL + mt.tv_nsec;
+    c.epoch_to_mono_offset_ns = rt_ns - mt_ns;
+
     return c;
 }
 
diff --git a/src/config.h b/src/config.h
index 663c675..6a51bfd 100644
--- a/src/config.h
+++ b/src/config.h
@@ -1,6 +1,10 @@
+// AIProf-local modification (Apache-2.0 4(b)): this file differs from
+// upstream cuprof. See VENDOR.md and patches/0002-align-cupti-epoch-to-clock-monotonic.patch.
 #ifndef CUPROF_CONFIG_H
 #define CUPROF_CONFIG_H
 
+#include <stdint.h>
+
 #include <string>
 
 namespace cuprof {
@@ -12,6 +16,10 @@ struct Config {
     // Optional unix socket to notify about lifecycle transitions. Empty
     // disables notification. See docs/embedding.md.
     std::string socket_path;
+    // Offset (ns) to subtract from CUPTI epoch timestamps to align with
+    // CLOCK_MONOTONIC (which PyTorch profiler / pyki uses). Computed once
+    // at start as (CLOCK_REALTIME - CLOCK_MONOTONIC).
+    uint64_t epoch_to_mono_offset_ns;
 };
 
 // Configuration sources, in priority order:
diff --git a/src/cupti_sink.cc b/src/cupti_sink.cc
index dc5eb53..38ff3b4 100644
--- a/src/cupti_sink.cc
+++ b/src/cupti_sink.cc
@@ -1,3 +1,5 @@
+// AIProf-local modification (Apache-2.0 4(b)): this file differs from
+// upstream cuprof. See VENDOR.md and patches/0002-align-cupti-epoch-to-clock-monotonic.patch.
 #include "cupti_sink.h"
 
 #include "notify.h"
@@ -266,7 +268,7 @@ void CuptiSink::Stop() {
     snapshot.swap(events_);  // leave the sink empty for the next window
     pthread_mutex_unlock(&mu_);
 
-    if (!WriteChromeTrace(cfg_.output, snapshot)) {
+    if (!WriteChromeTrace(cfg_.output, snapshot, cfg_.epoch_to_mono_offset_ns)) {
         fprintf(stderr, "[cuprof] failed to write %s\n", cfg_.output.c_str());
         // Without this, an orchestrator waiting for WriterOver would block
         // forever; Failed is the only terminal message that can replace it.
diff --git a/src/trace_writer.cc b/src/trace_writer.cc
index 5729b43..d72f564 100644
--- a/src/trace_writer.cc
+++ b/src/trace_writer.cc
@@ -1,3 +1,5 @@
+// AIProf-local modification (Apache-2.0 4(b)): this file differs from
+// upstream cuprof. See VENDOR.md and patches/0002-align-cupti-epoch-to-clock-monotonic.patch.
 #include "trace_writer.h"
 
 #include <unistd.h>
@@ -40,7 +42,8 @@ double ToMicros(uint64_t ns) { return static_cast<double>(ns) / 1000.0; }
 
 }  // namespace
 
-bool WriteChromeTrace(const std::string& path, const std::vector<Event>& events) {
+bool WriteChromeTrace(const std::string& path, const std::vector<Event>& events,
+                      uint64_t epoch_to_mono_offset_ns) {
     std::ofstream f(path.c_str());
     if (!f.is_open()) return false;
 
@@ -64,9 +67,15 @@ bool WriteChromeTrace(const std::string& path, const std::vector<Event>& events)
         const Event& e = events[i];
         if (!first) f << ",\n";
         first = false;
+        uint64_t adj_start = e.start_ns > epoch_to_mono_offset_ns
+                                 ? e.start_ns - epoch_to_mono_offset_ns
+                                 : e.start_ns;
+        uint64_t adj_end = e.end_ns > epoch_to_mono_offset_ns
+                               ? e.end_ns - epoch_to_mono_offset_ns
+                               : e.end_ns;
         f << "{\"ph\":\"X\",\"name\":\"" << Escape(e.name) << "\",\"cat\":\"" << e.category
-          << "\",\"ts\":" << ToMicros(e.start_ns)
-          << ",\"dur\":" << ToMicros(e.end_ns - e.start_ns) << ",\"pid\":" << pid
+          << "\",\"ts\":" << ToMicros(adj_start)
+          << ",\"dur\":" << ToMicros(adj_end - adj_start) << ",\"pid\":" << pid
           << ",\"tid\":" << e.stream_id << ",\"args\":{\"device\":" << e.device_id
           << ",\"correlation\":" << e.correlation_id;
         for (size_t a = 0; a < e.args.size(); ++a) {
diff --git a/src/trace_writer.h b/src/trace_writer.h
index 71094fd..d61aecc 100644
--- a/src/trace_writer.h
+++ b/src/trace_writer.h
@@ -1,3 +1,5 @@
+// AIProf-local modification (Apache-2.0 4(b)): this file differs from
+// upstream cuprof. See VENDOR.md and patches/0002-align-cupti-epoch-to-clock-monotonic.patch.
 #ifndef CUPROF_TRACE_WRITER_H
 #define CUPROF_TRACE_WRITER_H
 
@@ -22,8 +24,10 @@ struct Event {
 };
 
 // Writes events as Chrome Trace Event JSON. Returns false if the file cannot
-// be opened.
-bool WriteChromeTrace(const std::string& path, const std::vector<Event>& events);
+// be opened. epoch_to_mono_offset_ns is subtracted from each event timestamp
+// to convert CUPTI epoch nanoseconds to CLOCK_MONOTONIC (matching pyki).
+bool WriteChromeTrace(const std::string& path, const std::vector<Event>& events,
+                      uint64_t epoch_to_mono_offset_ns);
 
 }  // namespace cuprof
 
