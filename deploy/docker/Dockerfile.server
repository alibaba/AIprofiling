# SPDX-License-Identifier: Apache-2.0
#
# aiprof_server — dashboard + analysis image
#
# Contains:
#   * dashboardServer.js (Node/Express+WS)      — port 17000
#   * analysis_summary   (PyInstaller onefile) — invoked per upload
#   * webapp dist        (Vite React build)    — served at /webapp/
#
# Report URL (primary flow, generated by analysis_summary):
#   http://<host>:17000/api/v1/app_observ/aiAnalysis/report?analysisId=<uuid>
#
# Data volume: /var/lib/aiprof (results, uploads, persisted client state)

# ---------- Stage 1: build webapp (Vite React) ----------
FROM node:22-bookworm-slim AS webapp-builder
WORKDIR /src/ui/webapp
# BASE_PATH must match the runtime server's BASE_PATH: the bundle bakes the
# prefix into asset URLs, the router basename, and every /api|/ws|/resource
# URL it builds. Empty (default) means root-mounted.
ARG BASE_PATH=
ARG VITE_DEFAULT_INSTANCE=
ENV BASE_PATH=$BASE_PATH
ENV VITE_DEFAULT_INSTANCE=$VITE_DEFAULT_INSTANCE
RUN npm config set registry https://registry.npmmirror.com
COPY ui/webapp/package.json ui/webapp/package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY ui/webapp/ ./
RUN npm run build

# ---------- Stage 2: build analysis_summary (PyInstaller onefile) ----------
# Pin to bookworm — the stage-3 runtime is node:20-bookworm-slim (glibc 2.36).
# python:3.11-slim without a suite tag will float to trixie (glibc 2.38) and
# produce a onefile binary that fails to load on the runtime image.
FROM python:3.11-slim-bookworm AS analysis-builder
WORKDIR /src/server/dashboard
# binutils supplies objdump (PyInstaller onefile hard-requires it)
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends binutils \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
      pyinstaller ijson pandas numpy
COPY server/dashboard/analysis.py server/dashboard/gmem.py ./
RUN pyinstaller --clean --onefile \
      --name analysis_summary \
      --add-data "gmem.py:." \
      --hidden-import ijson \
      --hidden-import pandas \
      --hidden-import numpy \
      --hidden-import concurrent.futures \
      --hidden-import multiprocessing \
      analysis.py \
    && test -f /src/server/dashboard/dist/analysis_summary

# ---------- Stage 3: runtime (node + python3.11 + dashboardServer) ----------
# Node 22+ is required by `openclaw` (>=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0).
FROM node:22-bookworm-slim

# python3.11 keeps analysis.py's diff/report code path usable (dashboardServer
# will prefer the PyInstaller binary but falls back to python3 when the binary
# is missing). curl+tini for health checks / clean signal handling.
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip curl tini ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/server/dashboard

# Install runtime node deps only (skip devDeps for a smaller image).
COPY server/dashboard/package.json server/dashboard/package-lock.json* /app/server/dashboard/
RUN npm config set registry https://registry.npmmirror.com \
    && npm ci --omit=dev --no-audit --no-fund

# Application files (all env-driven; RESULT_DIR/UPLOAD_TMP/etc. point at /var/lib/aiprof).
COPY server/dashboard/dashboardServer.js \
     server/dashboard/auth.js \
     server/dashboard/ownership.js \
     server/dashboard/queue.js \
     server/dashboard/analysis.py \
     server/dashboard/gmem.py \
     server/dashboard/diff_analysis.py \
     server/dashboard/flamegraph.py \
     server/dashboard/report.py \
     /app/server/dashboard/
COPY server/dashboard/public/ /app/server/dashboard/public/

# Prebuilt analysis binary — must sit next to dashboardServer.js so its
# `path.join(__dirname, 'analysis_summary')` resolves.
COPY --from=analysis-builder /src/server/dashboard/dist/analysis_summary /app/server/dashboard/analysis_summary
RUN chmod +x /app/server/dashboard/analysis_summary

# Webapp dist — served as static assets under /webapp/.
COPY --from=webapp-builder /src/ui/webapp/dist /app/webapp

# Local Profiling Agent — independent module required by dashboardServer via
# `require('../../local-profiling-agent')`. Has its own deps (stream-json,
# minimist), installed separately from the server's node_modules.
COPY local-profiling-agent/package.json local-profiling-agent/package-lock.json* /app/local-profiling-agent/
RUN cd /app/local-profiling-agent && npm ci --omit=dev --no-audit --no-fund
COPY local-profiling-agent/src /app/local-profiling-agent/src
COPY local-profiling-agent/bin /app/local-profiling-agent/bin

# dashboardServer serves /aiprof/* from ./public and looks nowhere else for
# UI. Add a tiny bit of glue so `/webapp/*` and `/` also work.
# (dashboardServer respects UI_DIR when set — we symlink for zero-code-change.)
RUN mkdir -p /app/server/dashboard/public/webapp \
    && ln -sfn /app/webapp /app/server/dashboard/public/webapp/dist

ENV NODE_ENV=production \
    PORT=17000 \
    RESULT_DIR=/var/lib/aiprof/result \
    UPLOAD_TMP=/var/lib/aiprof/uploads \
    PERSISTENCE_DIR=/var/lib/aiprof/state \
    AIPROF_PYTHON=python3

# Baked in from the build ARG so the runtime server mounts its routes at the
# same prefix the webapp bundle was built for. A mismatch serves a UI that
# fetches from the wrong path, so the two must not be set independently.
ARG BASE_PATH=
ENV BASE_PATH=$BASE_PATH

# Optional: bake OpenClaw + Qwen provider into the image so the "本地 OpenClaw 分析"
# button works out of the box. When 0 (default), the UI installs OpenClaw on
# demand into $PERSISTENCE_DIR/openclaw at runtime (via POST /api/ai/openclaw/install).
ARG WITH_OPENCLAW=0
RUN if [ "$WITH_OPENCLAW" = "1" ]; then \
      npm install -g --registry=https://registry.npmjs.org openclaw \
      && openclaw plugins install @openclaw/qwen-provider \
      && openclaw --version ; \
    fi

VOLUME ["/var/lib/aiprof"]
EXPOSE 17000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:17000${BASE_PATH}/api/clients" >/dev/null || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dashboardServer.js"]
